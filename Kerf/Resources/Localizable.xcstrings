    "Headphones and their battery when they connect. Needs Bluetooth." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koptelefoons en hun batterij als ze verbinden. Heeft Bluetooth nodig."
